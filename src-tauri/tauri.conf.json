{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "synced+",
  "version": "1.3.0",
  "identifier": "mono.syncedplus",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ELRC Creator | synced+",
        "width": 1280,
        "height": 720,
        "minWidth": 405,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com blob: asset: https://tauri.localhost http://asset.localhost http://ipc.localhost https://ipc.localhost; media-src 'self' blob: asset: https://tauri.localhost http://asset.localhost; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "publisher": "mono",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
