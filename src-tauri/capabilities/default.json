{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {"url": "https://*"},
        {"url": "http://*"}
      ]
    }
  ]
}
